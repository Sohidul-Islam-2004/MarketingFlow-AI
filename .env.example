# ---------- required ----------
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/MarketingFlow?retryWrites=true&w=majority
PORT=3000
# 64 hex characters. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change it after connecting Pages (saved tokens can't be read anymore)
TOKEN_ENC_KEY=

# ---------- AI (Groq) ----------
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# ---------- Meta app (developers.facebook.com) ----------
FB_APP_ID=
FB_APP_SECRET=
# Your public https address + /auth/facebook/callback (add the same URL in Facebook Login settings)
FB_REDIRECT_URI=https://YOUR-DOMAIN/auth/facebook/callback
# Optional: Facebook Login for Business configuration id
FB_CONFIG_ID=
FB_GRAPH_VERSION=v23.0
# Any random text (keep it secret). The server uses it to register the webhook with Meta by itself.
META_WEBHOOK_VERIFY_TOKEN=

# Public https address of this server (Cloudflare tunnel or your domain). Meta sends messages here and downloads your post photos from it.
PUBLIC_BASE_URL=https://YOUR-DOMAIN

# ---------- legal pages (/privacy /terms /data-deletion) ----------
BUSINESS_NAME=MarketingFlow AI
SUPPORT_EMAIL=you@example.com
BUSINESS_ADDRESS=Dhaka, Bangladesh

# ---------- optional ----------
# The first account that signs up takes over this workspace id (keeps data from the old version)
DEFAULT_TENANT=org_123
# DNS used to find MongoDB Atlas. "system" = your computer's DNS. Default: Google DNS (8.8.8.8,8.8.4.4)
DNS_SERVERS=8.8.8.8,8.8.4.4
# JOBS=off stops automatic publishing and comment replies (useful while testing)
JOBS=on

# ---- Super Admin ----
# Your email(s). These accounts see the Admin menu (Customers, All Pages).
SUPER_ADMIN_EMAILS=you@gmail.com
# "on" = anyone can create an account. Off = only you create accounts in Admin -> Customers.
ALLOW_SIGNUP=off
# Shown on the login page for "Forgot password?"
SUPPORT_CONTACT=WhatsApp 01XXXXXXXXX
